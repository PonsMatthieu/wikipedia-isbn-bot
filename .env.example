# Aucune clé n'est nécessaire pour la démo ou pour Wikipédia/BnF/Sudoc/Open Library.
BOT_OPERATOR=Mésange_Futée
BOT_USER_AGENT=MesangeISBNBot/0.1 (https://fr.wikipedia.org/wiki/Utilisateur:M%C3%A9sange_Fut%C3%A9e)
WIKI_API=https://fr.wikipedia.org/w/api.php
WIKI_CATEGORY=Catégorie:Page avec ISBN invalide

# DRY_RUN ou REVIEW_ONLY. Le job run ne publie jamais dans cette V1.
BOT_MODE=DRY_RUN
BOT_WRITE_ENABLED=false
BOT_COMMUNITY_APPROVED=false
WIKI_BOT_LOGIN=
WIKI_BOT_PASSWORD=
WIKI_BOT_ACCOUNT=

# Laisser vide sur Toolforge : utilisation automatique de TOOL_DATA_DIR/isbn-bot.
BOT_DATA_DIR=
BOT_REPORT_DIR=
BOT_MAX_PAGES=20
BOT_MAX_EDITS=3
BOT_REQUEST_DELAY=1.1
BOT_TIMEOUT=30
BOT_MAX_RETRIES=4

# Fournisseurs sans clé activés par défaut.
# Pour inclure Google Books : BOT_SOURCES=bnf,sudoc,openlibrary,googlebooks
# GOOGLE_BOOKS_API_KEY est requis ; ne jamais publier cette clé dans Git.
BOT_SOURCES=bnf,sudoc,openlibrary
GOOGLE_BOOKS_API_KEY=

# Facultatif : un message regroupé par run. Désactivé tant que MAIL_HOST est vide.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
